{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "publicMessages": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('members/' + auth.uid).val() == true || newData.child('members/' + auth.uid).val() == true)",

        "members": {
          ".read": "auth != null",
          ".write": "auth != null"
        },

        "messages": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
